# Pinata JWT (server-side only — pinned metadata endpoint)
PINATA_JWT=your_pinata_jwt_here

# Public Sepolia RPC used by the unauthenticated /verify portal
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Contract address override. Precedence: shared/contract.json -> this env -> 0x0 stub
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud project id (used by RainbowKit's default connectors)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000